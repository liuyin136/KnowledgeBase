# syntax=docker/dockerfile:1.7
# =============================================================================
# Dockerfile.backend — Local-First RAG Platform (experiment node deleted)
#
# ARCHITECTURAL DESIGN & TRADE-OFFS
# =================================
#
# Goal
#   Produce a single GPU-capable image that runs the FastAPI backend (uvicorn)
#   AND the RQ api-worker (same image, different CMD). Target: Windows Docker
#   Desktop + WSL2 + NVIDIA GPU passthrough (GTX 3070 Ti / 8 GB VRAM), also
#   deployable on Linux with the NVIDIA Container Toolkit.
#
# Why multi-stage (2 stages)?
#   Stage 1 (model-downloader) — python:3.12-slim, installs huggingface_hub +
#     git-lfs, downloads the embedding + reranker model weights into /app/models.
#     Kept separate so weight-download (slow, ~2-5 GB, network-bound) is a
#     distinct cached layer independent of backend code changes.
#   Stage 2 (runtime) — nvidia/cuda:13.3.0-devel-ubuntu26.04 + Python 3.12,
#     installs pip deps, copies models from stage 1 + backend code. The devel
#     flavor is used (per v1.3 directive) so that any future source-built CUDA
#     extension (flash-attention, custom kernels) compiles without a base-image
#     swap. Trade-off: the image is ~2 GB larger than the -runtime- flavor; we
#     accept this for forward compatibility and because Jina v5 / BGE-M3 may
#     pull in wheels that expect a full CUDA toolchain at install time.
#
# Why BuildKit cache mounts?
#   • `--mount=type=cache,target=/root/.cache/huggingface` — the HF hub cache is
#     reused across builds so re-building the image after a code change does NOT
#     re-download multi-GB model weights.
#   • `--mount=type=cache,target=/root/.cache/pip` — pip wheel cache is reused
#     across builds, speeding up the `pip install -r requirements.txt` layer.
#   Both require BuildKit: `DOCKER_BUILDKIT=1 docker compose build` (enabled by
#   default in Docker Desktop ≥ 4.34 and Docker Engine ≥ 23.0).
#
# Base image choice: nvidia/cuda:13.3.0-devel-ubuntu26.04 (v1.3 directive)
#   • CUDA 13.3 is the latest stable as of the v1.3 spec. It is ABI-compatible
#     with the PyTorch cu121/cu124 wheels via the driver-forward-compat model:
#     the host NVIDIA driver must be ≥ the CUDA version the toolkit was built
#     against. On Windows Docker Desktop + WSL2, the driver is shared between
#     Windows and WSL2 — install the latest NVIDIA Windows driver.
#   • Ubuntu 26.04 base ships Python 3.12 in apt (no deadsnakes PPA needed),
#     which simplifies the runtime stage vs the v1.2 Ubuntu 22.04 path.
#
# Build context: ../backend  (set in docker/docker-compose.yml)
#   → all COPY paths in this Dockerfile are relative to the backend/ root.
#
# PYTHONPATH=/app is set so developers can `docker compose exec backend python
# scripts/init_neo4j.py` (or any .py under scripts/ or app/) without extra env.
#
# Model selection (v1.3): Jina v5 default + BGE-M3 optional.
#   • Stage 1 downloads jinaai/jina-embeddings-v5-text-small + jinaai/jina-reranker-v3
#     by default (DOWNLOAD_BGE=0).
#   • Set build arg DOWNLOAD_BGE=1 to ALSO fetch BAAI/bge-m3 + BAAI/bge-reranker-base
#     (enables the frontend Settings toggle to switch without re-pulling).
# =============================================================================

# -----------------------------------------------------------------------------
# Stage 1 — model-downloader
# -----------------------------------------------------------------------------
FROM python:3.13-slim AS model-downloader

# Build-time args.
ARG DOWNLOAD_BGE=0
ARG HF_HUB_DOWNLOAD_TIMEOUT=120
ENV HF_HOME=/root/.cache/huggingface \
    HF_HUB_DOWNLOAD_TIMEOUT=${HF_HUB_DOWNLOAD_TIMEOUT} \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# git-lfs is required by huggingface_hub for repos that store weights via LFS.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        git-lfs \
    && git lfs install \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir --upgrade pip \
 && pip install --no-cache-dir "huggingface_hub>=0.24,<0.30"

WORKDIR /app

# Clean, single download script (v1.3 — Jina default + optional BGE).
# Uses BuildKit cache mount on the HF cache dir so rebuilds skip re-downloading.
COPY /scripts/download_models2.py ./
RUN echo "=== Checking download_models.py ===" && \
    ls -la /app/download_models2.py && \
    echo "=== File content preview ===" && \
    head -n 20 /app/download_models2.py

RUN --mount=type=cache,target=/root/.cache/huggingface,sharing=locked \
    DOWNLOAD_BGE=${DOWNLOAD_BGE} python /app/download_models2.py

# -----------------------------------------------------------------------------
# Stage 2 — runtime
# -----------------------------------------------------------------------------
FROM nvidia/cuda:13.3.0-devel-ubuntu26.04 AS runtime

# Ubuntu 26.04 ships Python 3.12 in apt — no deadsnakes PPA needed.
# Minimal system deps:
#   • build-essential — any wheel compilation (rare; most wheels are prebuilt)
#   • libgomp1       — OpenMP for torch CPU ops
#   • libgl1, libglib2.0-0 — runtime libs some tokenizers/image deps pull in
#   • ca-certificates, curl — healthcheck + outbound HTTPS to HuggingFace
#   • git            — pip -e git+... fallbacks + HF hub clone fallbacks
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_BREAK_SYSTEM_PACKAGES=1 \
    CUDA_VISIBLE_DEVICES=0 \
    MODEL_PATH=/app/models \
    PYTHONPATH=/app \
    HF_HOME=/root/.cache/huggingface \
    TRANSFORMERS_CACHE=/root/.cache/huggingface/hub

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        build-essential \
        libgomp1 \
        libgl1 \
        libglib2.0-0 \
        python3 \
        python3-venv \
        python3-dev \
 && rm -rf /var/lib/apt/lists/* \
 && update-alternatives --install /usr/bin/python python /usr/bin/python3 1 \
 && curl -fsSLo /tmp/get-pip.py https://bootstrap.pypa.io/get-pip.py \
 && python3 /tmp/get-pip.py \
 && rm /tmp/get-pip.py \
 && pip install --upgrade pip setuptools wheel

WORKDIR /app

# ---- Install Python deps (BuildKit pip cache mount) --------------------------
# ---- 安裝 Python 依賴（使用清華鏡像加速） -----------------------------
COPY requirements.txt ./

RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    pip install -r requirements.txt \
        --index-url https://pypi.tuna.tsinghua.edu.cn/simple \
        --extra-index-url https://download.pytorch.org/whl/cu124
        
# ---- Copy models from stage 1 ------------------------------------------------
COPY --from=model-downloader /app/models /app/models

# ---- Copy backend application code -------------------------------------------
# Build context is ../backend, so `COPY . ./` pulls in app/, scripts/,
# pyproject.toml, etc. The backend/.dockerignore excludes __pycache__, .venv,
# models/ (host-side dev downloads), tests, etc.
COPY . ./

# Ensure scripts are executable (download_models.py / init_neo4j.py are
# invoked via `docker compose exec backend python scripts/...`).
RUN if [ -d scripts ]; then chmod -R +x scripts || true; fi

EXPOSE 8000

# Default CMD — the api-worker service overrides `command` in compose to run
# `python -m app.workers.worker` instead.
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]

# Healthcheck: FastAPI exposes GET /health (per Backend Design Scope v1.1).
HEALTHCHECK --interval=15s --timeout=5s --start-period=60s --retries=5 \
    CMD curl -fsS http://localhost:8000/health || exit 1
