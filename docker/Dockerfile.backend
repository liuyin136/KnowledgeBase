# syntax=docker/dockerfile:1.7
# =============================================================================
# Dockerfile.backend — Local-First RAG Experimentation Platform v1.2
# Multi-stage build per infrastructure-environment-spec_v1.1.md §2
#
# Build context: ../backend   (set in docker/docker-compose.yml)
#   → COPY paths inside this Dockerfile are relative to backend/ root.
#
#   Stage 1 (model-downloader)  : python:3.12-slim + huggingface_hub + git-lfs
#                                 Downloads BAAI/bge-m3 (+ optional reranker)
#                                 into /app/models. Uses BuildKit cache mount
#                                 for HF cache to speed up rebuilds.
#   Stage 2 (runtime)           : nvidia/cuda:12.4.1-runtime-ubuntu22.04 + Python 3.12
#                                 Minimal inference image; copies models + backend code.
#
# Base-image choice note (deviation from spec wording, documented):
#   The infra spec §1 mentions `nvidia/cuda:12.4.1-devel-ubuntu22.04`. We use
#   the `-runtime-` flavor instead because:
#     • The backend runs inference only (sentence-transformers + transformers).
#     • PyTorch ships pre-built CUDA wheels (cu121) — no nvcc needed at runtime.
#     • The `-devel-` image is ~6 GB larger and only required when compiling
#       CUDA kernels from source, which v1 does not do.
#   This keeps the runtime image small while still exposing `nvidia-smi` and
#   the CUDA driver libs from the host via the NVIDIA Container Toolkit.
# =============================================================================

# -----------------------------------------------------------------------------
# Stage 1 — model-downloader
# -----------------------------------------------------------------------------
FROM python:3.12-slim AS model-downloader

# Build-time args — allow opting into the reranker without rewriting the file.
ARG DOWNLOAD_RERANKER=1
ARG HF_HUB_DOWNLOAD_TIMEOUT=60
ENV HF_HOME=/root/.cache/huggingface \
    HF_HUB_DOWNLOAD_TIMEOUT=${HF_HUB_DOWNLOAD_TIMEOUT} \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# git-lfs is required by huggingface_hub for repos that store weights via LFS.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        git-lfs \
    && git lfs install \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir --upgrade pip \
 && pip install --no-cache-dir "huggingface_hub>=0.24,<0.30"

WORKDIR /app

# Inline download script — does NOT depend on backend/scripts existing yet.
# Downloads BAAI/bge-m3 (primary embedding, 1024-dim) and, when
# DOWNLOAD_RERANKER=1, BAAI/bge-reranker-base (cross-encoder for Slice 5).
# To leverage BuildKit cache mounts, build with:
#   DOCKER_BUILDKIT=1 docker compose build backend
RUN --mount=type=cache,target=/root/.cache/huggingface,sharing=locked \
    <<'EOF'
set -euo pipefail
cat > /app/download_models.py <<'PY'
import os
from huggingface_hub import snapshot_download

MODELS = ["BAAI/bge-m3"]
if os.environ.get("DOWNLOAD_RERANKER", "1") == "1":
    MODELS.append("BAAI/bge-reranker-base")

target_root = "/app/models"
os.makedirs(target_root, exist_ok=True)

for repo_id in MODELS:
    # Use a per-repo subdir so MODEL_PATH can be a parent dir and code can
    # resolve individual models by name (e.g. /app/models/bge-m3).
    local_name = repo_id.split("/")[-1]
    dest = os.path.join(target_root, local_name)
    print(f"[download] {repo_id} -> {dest}", flush=True)
    snapshot_download(
        repo_id=repo_id,
        local_dir=dest,
        local_dir_use_symlinks=False,
        # Skip *.msgpack / *.h5 optimizer states + ONNX variants to shave
        # ~1.5 GB off bge-m3 (we only need the safetensors + tokenizer).
        ignore_patterns=["*.msgpack", "*.h5", "rust_model.onnx", "onnx/*"],
        resume_download=True,
    )
print("[download] done", flush=True)
PY
DOWNLOAD_RERANKER=${DOWNLOAD_RERANKER} python /app/download_models.py
EOF

# -----------------------------------------------------------------------------
# Stage 2 — runtime
# -----------------------------------------------------------------------------
FROM nvidia/cuda:12.4.1-runtime-ubuntu22.04 AS runtime

# Python 3.12 from deadsnakes (Ubuntu 22.04 ships 3.10 by default).
# Minimal system deps:
#   • build-essential — any wheel compilation (rare; most wheels are prebuilt)
#   • libgomp1       — OpenMP for onnxruntime / scikit-learn / torch CPU ops
#   • libgl1, libglib2.0-0 — runtime libs some tokenizers/image deps pull in
#   • ca-certificates, curl — healthcheck + outbound HTTPS to HuggingFace
#   • git            — pip -e git+... fallbacks if needed
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    CUDA_VISIBLE_DEVICES=0 \
    MODEL_PATH=/app/models \
    HF_HOME=/root/.cache/huggingface \
    TRANSFORMERS_CACHE=/root/.cache/huggingface/hub

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        software-properties-common \
        ca-certificates \
        curl \
        git \
        build-essential \
        libgomp1 \
        libgl1 \
        libglib2.0-0 \
    && add-apt-repository -y ppa:deadsnakes/ppa \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        python3.12 \
        python3.12-venv \
        python3.12-dev \
        python3.12-distutils \
    && rm -rf /var/lib/apt/lists/* \
    && update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.12 1 \
    && update-alternatives --install /usr/bin/python python /usr/bin/python3.12 1 \
    && curl -fsSLo /tmp/get-pip.py https://bootstrap.pypa.io/get-pip.py \
    && python3 /tmp/get-pip.py \
    && rm /tmp/get-pip.py \
    && pip install --upgrade pip setuptools wheel

WORKDIR /app

# ---- Install Python deps ------------------------------------------------------
# Copy requirements first for layer caching. Wildcard pattern tolerates the
# case where the backend agent has not committed requirements.txt yet
# (BuildKit treats a zero-match glob as a no-op). The RUN below writes a
# minimal pin if the file is missing so the image still builds.
COPY requirements.txt* ./

RUN if [ ! -s requirements.txt ]; then \
        echo "WARN: backend/requirements.txt missing — using minimal pin"; \
        printf '%s\n' \
            'fastapi==0.115.5' \
            'uvicorn[standard]==0.32.1' \
            'pydantic==2.10.3' \
            'pydantic-settings==2.6.1' \
            'neo4j==5.26.0' \
            'redis==5.2.0' \
            'rq==1.16.2' \
            'sentence-transformers==3.3.1' \
            'transformers==4.46.3' \
            'torch==2.5.1' \
            'numpy==1.26.4' \
            'python-multipart==0.0.17' \
            'httpx==0.28.1' \
            'tenacity==9.0.0' \
            'structlog==24.4.0' \
            > requirements.txt; \
    fi \
 && pip install --no-cache-dir -r requirements.txt

# ---- Copy models from stage 1 -------------------------------------------------
COPY --from=model-downloader /app/models /app/models

# ---- Copy backend application code --------------------------------------------
# Build context is ../backend, so `COPY . ./` pulls in app/, scripts/,
# pyproject.toml, etc. The backend/.dockerignore excludes __pycache__, .venv,
# models/ (host-side dev downloads), tests, etc.
COPY . ./

# Ensure scripts are executable (download_models.py / init_neo4j.py are
# invoked via `docker compose run --rm backend python scripts/...`).
RUN if [ -d scripts ]; then chmod -R +x scripts || true; fi

EXPOSE 8000

# Default CMD — the api-worker service overrides `command` in compose to run
# `python -m app.workers.worker` instead.
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]

# Healthcheck: FastAPI exposes GET /health (per Backend Design Scope v1.1).
HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=5 \
    CMD curl -fsS http://localhost:8000/health || exit 1
