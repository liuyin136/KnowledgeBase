# syntax=docker/dockerfile:1.7
# =============================================================================
# Dockerfile.worker — GPU worker (models, scripts, RQ job execution)
# =============================================================================

# -----------------------------------------------------------------------------
# Stage 1 — model-downloader
# -----------------------------------------------------------------------------
FROM python:3.13-slim AS model-downloader

ARG HF_HUB_DOWNLOAD_TIMEOUT=120
ENV HF_HOME=/root/.cache/huggingface \
    HF_HUB_DOWNLOAD_TIMEOUT=${HF_HUB_DOWNLOAD_TIMEOUT} \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        git-lfs \
    && git lfs install \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir --upgrade pip \
 && pip install --no-cache-dir "huggingface_hub>=0.24"

WORKDIR /app

COPY download_models2.py /app/download_models2.py

RUN --mount=type=cache,target=/root/.cache/huggingface,sharing=locked \
    MODEL_PATH=/app/models python /app/download_models2.py

# -----------------------------------------------------------------------------
# Stage 2 — runtime
# -----------------------------------------------------------------------------
FROM nvidia/cuda:13.3.0-devel-ubuntu26.04 AS runtime

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_BREAK_SYSTEM_PACKAGES=1 \
    CUDA_VISIBLE_DEVICES=0 \
    MODEL_PATH=/app/models \
    PYTHONPATH=/app \
    HF_HOME=/root/.cache/huggingface \
    TRANSFORMERS_CACHE=/root/.cache/huggingface/hub

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        build-essential \
        libgomp1 \
        libgl1 \
        libglib2.0-0 \
        python3 \
        python3-venv \
        python3-dev \
 && rm -rf /var/lib/apt/lists/* \
 && update-alternatives --install /usr/bin/python python /usr/bin/python3 1 \
 && curl -fsSLo /tmp/get-pip.py https://bootstrap.pypa.io/get-pip.py \
 && python3 /tmp/get-pip.py \
 && rm /tmp/get-pip.py \
 && pip install --upgrade pip setuptools wheel

WORKDIR /app

COPY requirements-worker.txt ./

RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    pip install -r requirements-worker.txt \
        --index-url https://pypi.tuna.tsinghua.edu.cn/simple \
        --extra-index-url https://download.pytorch.org/whl/cu124

RUN CMAKE_ARGS="-DGGML_CUDA=on" pip install llama-cpp-python

COPY --from=model-downloader /app/models /app/models

COPY download_models2.py ./
COPY scripts ./scripts
COPY app/__init__.py ./app/
COPY app/workers ./app/workers

RUN if [ -d scripts ]; then chmod -R +x scripts || true; fi

CMD ["python", "-m", "app.workers.worker"]
